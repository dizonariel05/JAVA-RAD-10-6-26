import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
            
        System.out.print("Enter your name: ");
        String userName = scanner.nextLine();

        System.out.print("Enter your adress: ");
        String userAddress = scanner.nextLine();
            
        System.out.print("Enter your age: ");
        int userAge = scanner.nextInt();
            
        System.out.print("Enter your weight: ");
        float userWeight = scanner.nextFloat();
            
        System.out.print("Enter your height: ");
        float userHeight = scanner.nextFloat();

            
        System.out.println(" Your name is " + userName + ". You are " + userAge + " years old. You live in " + userAddress + ". Your weight is " + userWeight + ", and your height is " + userHeight + " meter.");

        scanner.close();
    }
}

